<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_heart_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_quick_heart_background">

        <ImageView
            android:id="@+id/widget_quick_heart_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="Hızlı Kalp Gönder"
            android:src="@drawable/ic_widget_heart" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_quick_heart_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_background"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="Kalp Gönder ❤️"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
